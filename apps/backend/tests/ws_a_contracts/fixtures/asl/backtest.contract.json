  "forbidden_responsibilities": [
    "creating a second Backtest Core",
    "letting RQAlpha own V3 ledger/result identity",
    "silent engine fallback"
  ],
  "global_invariants": [
    "No generic execute(action,payload)",
    "No direct renderer access to SQLite, DuckDB or Parquet",
    "No large tabular/numeric JSON payload; return ArtifactRef",
    "No worker-owned identity, registry or financial truth",
    "No silent fallback between Demo, Formal, connector, engine or environment",
    "Published/versioned objects are immutable"
  ]
