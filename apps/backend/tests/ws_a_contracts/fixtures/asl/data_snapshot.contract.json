              "type": "string",
              "description": "Stable validation key"
            }
          }
        }
      },
      "response_dto": {
        "name": "ValidateSnapshotCandidateAcceptedV1",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "task_id",
            "run_id",
            "accepted_state"
          ],
          "properties": {
            "request_id": {
              "type": "string",
