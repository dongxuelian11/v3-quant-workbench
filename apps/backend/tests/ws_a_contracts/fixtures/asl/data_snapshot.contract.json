{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_schema_id": "urn:v3:asl-contract-envelope:1.0.0",
  "contract_id": "urn:v3:asl:data_snapshot:1.0.0",
  "service": "DataSnapshotService",
  "api_version": "1.0.0",
  "compatibility": {
    "major": "breaking",
    "minor": "additive only",
    "patch": "clarification/no wire-shape change"
  },
  "domain_owner": "Data Truth Domain",
  "repository_dependencies": [
    "RawCaptureRepository",
    "SnapshotRepository",
    "SnapshotValidationRepository",
    "ArtifactRepository",
    "TaskRepository",
    "ProvenanceRepository"
  ],
  "transport_binding": {
    "namespace": "asl.v1.DataSnapshotService",
    "business_ownership": false
  },
  "availability_states": [
    "FORMAL",
    "DEMO",
    "UNAVAILABLE"
  ],
  "methods": [
    {
      "operation_id": "DataSnapshotService.v1.createSnapshotCandidate",
      "version": "1.0.0",
      "kind": "ASYNC_COMMAND",
      "request_dto": {
        "name": "CreateSnapshotCandidateRequestV1",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "project_id",
            "project_context_revision_id",
            "expected_api_version",
            "raw_capture_artifact_ids",
            "normalization_spec_version",
            "idempotency_key"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "description": "Caller-generated UUIDv7; transport deduplication only",
              "format": "uuid"
            },
            "project_id": {
              "type": "string",
              "description": "Stable project identity",
              "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "project_context_revision_id": {
              "type": "string",
              "description": "Immutable project-context revision identity",
              "pattern": "^pcr_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "expected_api_version": {
              "type": "string",
              "description": "Exact ASL major.minor contract expected by caller",
              "const": "1.0"
            },
            "raw_capture_artifact_ids": {
              "type": "array",
              "description": "Immutable raw captures",
              "items": {
                "type": "string",
                "description": "Content-addressed artifact identity",
                "pattern": "^art_sha256_[0-9a-f]{64}$"
              },
              "minItems": 1
            },
            "normalization_spec_version": {
              "type": "string",
              "description": "Pinned normalizer contract"
            },
            "idempotency_key": {
              "type": "string",
              "description": "Stable candidate key"
            }
          }
        }
      },
      "response_dto": {
        "name": "CreateSnapshotCandidateAcceptedV1",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_id",
            "task_id",
            "run_id",
            "accepted_state"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "description": "Echoed request identity",
              "format": "uuid"
            },
            "task_id": {
              "type": "string",
              "description": "Durable user-work identity",
              "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "run_id": {
              "type": "string",
              "description": "Immutable financial-input run identity",
              "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "accepted_state": {
              "type": "string",
              "description": "Persisted acceptance state",
              "const": "QUEUED"
            },
            "event_cursor": {
              "type": "integer",
              "description": "First durable event sequence",
              "minimum": 1
            }
          }
        }
      },
      "idempotency": {
        "mode": "REQUEST_ID",
        "scope": "operation_id + project_id + idempotency_key/request_id",
        "same_key_same_canonical_request": "return_original_outcome",
        "same_key_different_canonical_request": "IDEMPOTENCY_CONFLICT"
      },
      "async_behavior": {
        "creates_task_run": true,
        "run_identity_inputs": [
          "raw capture hashes",
          "normalization spec",
          "connector versions"
        ],
        "artifact_outputs": [
          "CanonicalParquetSet",
          "SnapshotCandidateManifest"
        ],
        "cancel": "COOPERATIVE_BEFORE_ATOMIC_MANIFEST_COMMIT",
        "retry": "NEW_ATTEMPT_SAME_RUN",
        "resume": "FROM_PARTITION_CHECKPOINT",
        "input_change": "MUST_CREATE_NEW_RUN",
        "attempt_rule": "retry/resume always creates a new TaskAttempt; previous attempts are immutable"
      },
      "truth_pit_preconditions": [
        "every raw capture has provider, available_time, ingested_at and hash",
        "alias conflicts absent"
      ],
      "errors": [
        "INVALID_ARGUMENT",
        "VERSION_MISMATCH",
        "NOT_FOUND",
        "CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "CAPABILITY_UNAVAILABLE",
        "TRUTH_PRECONDITION_FAILED",
        "PIT_UNPROVABLE",
        "ARTIFACT_NOT_PUBLISHED",
        "RESOURCE_REJECTED",
        "INTERNAL_ERROR"
      ],
      "provenance_required": [
        "request_actor",
        "project_context_revision_id",
        "operation_id",
        "contract_version",
        "input_object_ids",
        "input_content_hashes",
        "environment_profile_id",
        "code_version"
      ],
      "read_models": [],
      "frontend_capabilities": [
        "data update"
      ]
    },
