  "forbidden_responsibilities": [
    "delegating ModelVersion identity to MLflow/Qlib",
    "unsafe pickle loading without admission",
    "implicit GPU/CPU fallback"
  ],
  "global_invariants": [
    "No generic execute(action,payload)",
    "No direct renderer access to SQLite, DuckDB or Parquet",
    "No large tabular/numeric JSON payload; return ArtifactRef",
