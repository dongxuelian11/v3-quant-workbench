{
  "schema_id": "urn:v3:domain-object-registry:1.0.0",
  "scope": "A-share daily/EOD Canonical Backend",
  "identity_rules": {
    "ulid": "Crockford uppercase, monotonic per process",
    "content_address": "sha256 lowercase hex",
    "provider_code": "never canonical"
