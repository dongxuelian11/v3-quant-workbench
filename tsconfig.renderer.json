{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "react", "react-dom"],
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["apps/desktop/src/renderer/**/*.ts", "apps/desktop/src/renderer/**/*.tsx", "packages/contracts/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
