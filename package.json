{
  "name": "v3-oss-rebuild",
  "version": "1.2.0",
  "private": true,
  "description": "Windows A-share quantitative research desktop with open-source Python engines.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.13.0",
  "main": "dist/apps/desktop/src/researchMain.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev-research.mjs",
    "setup:research": "node scripts/setup-research.mjs",
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "test": "node scripts/test-research.mjs",
    "test:research": "node scripts/test-research.mjs",
    "package:win": "npm run package:win:release",
    "package:win:unpacked": "npm run build && node scripts/prepare-research-package.mjs && electron-builder --win dir --x64 --config electron-builder.yml",
    "package:win:release": "npm run build && node scripts/prepare-research-package.mjs && electron-builder --win --x64 --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@xyflow/react": "12.11.2",
    "ajv": "8.20.0",
    "cmdk": "1.1.1",
    "dockview-react": "7.0.4",
    "echarts": "6.1.0",
    "electron-store": "10.1.0",
    "klinecharts": "10.0.3",
    "lightweight-charts": "5.2.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
