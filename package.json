{
  "name": "v3-oss-rebuild",
  "version": "1.0.0",
  "private": true,
  "description": "Pre-alpha V3 quantitative research workbench under active open-source reconstruction.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.13.0",
  "main": "dist/apps/desktop/src/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "build:determinism": "node scripts/deterministic-build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:unit": "npm run test",
    "test:backend": "node scripts/backend-foundation-test.mjs",
    "test:runtime": "node --test tests/ws_e_electron_runtime/*.test.mjs",
    "smoke:electron": "node scripts/run-electron-smoke.mjs",
    "smoke:electron:runtime": "node scripts/run-runtime-core-electron-smoke.mjs",
    "smoke:frontend": "node scripts/public-frontend-smoke.mjs",
    "smoke:visual-evidence": "node scripts/frontend-smoke.mjs",
    "smoke:research-pipeline": "node scripts/research-pipeline-smoke.mjs",
    "smoke:model-pipeline": "node scripts/model-pipeline-smoke.mjs",
    "smoke:alpha-research": "node scripts/alpha-research-smoke.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "repo-audit": "node scripts/repo-audit.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "sbom:check": "node scripts/generate-sbom.mjs --check",
    "evidence:generate": "node scripts/generate-result.mjs",
    "validate:authority": "node scripts/validate-project-authority.mjs",
    "verify:build-manifest": "node scripts/verify-build-manifest.mjs",
    "validate": "npm run validate:public && npm run smoke:electron && npm run smoke:visual-evidence",
    "validate:public": "npm run validate:authority && npm run typecheck && npm run lint && npm test && npm run test:backend && npm run build && npm run verify:build-manifest && npm run test:runtime && npm run smoke:frontend && npm run secret-scan && npm run repo-audit && npm run sbom:check",
    "smoke:product-runtime": "node scripts/product-runtime-smoke.mjs",
    "smoke:desktop-b3": "node scripts/run-desktop-b3-smoke.mjs",
    "smoke:product-entry": "node scripts/product-entry-smoke.mjs",
    "smoke:product-research": "node scripts/product-research-smoke.mjs",
    "package:win": "npm run package:win:release",
    "package:win:unpacked": "npm run build && node scripts/prepare-packaged-backend.mjs && electron-builder --win dir --x64 --config electron-builder.yml",
    "package:win:release": "npm run build && node scripts/prepare-packaged-backend.mjs && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke:packaged-win": "node scripts/packaged-runtime-smoke.mjs",
    "smoke:product-closure": "node scripts/product-closure-packaged-e2e.mjs",
    "smoke:product-release": "node scripts/product-release-packaged-e2e.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@xyflow/react": "12.11.2",
    "ajv": "8.20.0",
    "cmdk": "1.1.1",
    "dockview-react": "7.0.4",
    "echarts": "6.1.0",
    "electron-store": "10.1.0",
    "lightweight-charts": "5.2.0",
    "monaco-editor": "0.56.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
